[Unit]
Description=Recreate the appbox distrobox from the latest signed image
Documentation=https://github.com/Danathar/appbox
# Right after a laptop resumes the network may still be coming up; retry like
# Aurora's uupd.service does.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
# Runs from the repo checkout; the script fast-forwards it on every run.
# host/install adds a drop-in if the checkout lives somewhere else.
ExecStart=%h/claude/appbox/host/appbox-update
Restart=on-failure
RestartSec=2min
TimeoutStartSec=1h
