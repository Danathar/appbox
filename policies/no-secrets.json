{
    "$comment": "No private keys or secret files in the tree. Evaluated by scripts/check-policies.mjs; it reports the path only, never the content. Explained in policies/README.md and docs/security/SECURITY-AI.md section 2.",
    "forbiddenFileGlobs": [
        "**/cosign.key",
        "**/*.key",
        "**/.env",
        "**/.env.*",
        "**/id_rsa",
        "**/id_ecdsa",
        "**/id_ed25519",
        "**/*.p12",
        "**/*.pfx",
        "**/*.jks",
        "**/.netrc",
        "**/kubeconfig"
    ],
    "allowFileGlobs": [],
    "forbiddenContentPatterns": [
        "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "\\bghp_[A-Za-z0-9]{36}\\b",
        "\\bgithub_pat_[A-Za-z0-9_]{60,}",
        "\\bsk-ant-[A-Za-z0-9_-]{20,}"
    ],
    "maxScanBytes": 1048576
}
