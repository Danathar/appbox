# Per-machine settings for host/appbox-update.
#
# Copy to hosts/<short hostname>.env (the output of `hostname -s`), keep the
# lines you want to change, commit, and push. Every machine pulls the repo on
# its next timer run and reads only its own file. Plain KEY=VALUE lines, no
# quotes, no shell. Unknown keys are ignored with a warning. A variable set in
# the service's environment (a systemd drop-in) overrides this file.

# Recreate the box once it is this many days old (default 7). A desktop
# notification asks you to quit the apps once it is twice this old.
APPBOX_MAX_AGE_DAYS=7

# distrobox.ini to use, relative to the repo root (default distrobox.ini).
# Point a machine at its own file, e.g. hosts/<hostname>.ini, to give it
# extra or different apps.
APPBOX_INI=distrobox.ini

# 1 = fast-forward the repo checkout before each run (default). Set 0 on a
# checkout you develop in, so the timer never pulls into your work.
APPBOX_SELF_UPDATE=1
